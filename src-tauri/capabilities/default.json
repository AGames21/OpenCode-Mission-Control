{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Mission Control filesystem access to OpenCode config",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "notification:default",
    "process:default",
    "updater:default",
    "fs:allow-read-file",
    "fs:allow-read-text-file",
    "fs:allow-write-file",
    "fs:allow-write-text-file",
    "fs:allow-exists",
    {
      "identifier": "fs:scope",
      "allow": [{ "path": "$HOME/.config/opencode/**" }, { "path": "$HOME/.config/opencode" }]
    }
  ]
}
